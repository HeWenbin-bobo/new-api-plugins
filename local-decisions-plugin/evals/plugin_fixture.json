{
  "cases": [
    {
      "name": "choice and noul request builds a systemone submit",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "Piccolo-4B-Q4_K_M",
          "baseUrl": "http://127.0.0.1:18083",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "action": {
                "type": "choice",
                "instructions": "Select the next action.",
                "criteria": {
                  "read": "Read without modifying.",
                  "write": "Modify the file."
                }
              }
            }
          }
        }
      ],
      "expected": {
        "url": "http://127.0.0.1:18083/v1/systemone",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "model": "Piccolo-4B-Q4_K_M",
          "state": "A read-only request.",
          "questions": {
            "action": {
              "type": "choice",
              "instructions": "Select the next action.",
              "criteria": {
                "read": "Read without modifying.",
                "write": "Modify the file."
              }
            }
          }
        }
      }
    },
    {
      "name": "configured base URL with /v1 suffix is normalized",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "Piccolo-9B-Q8_0",
          "baseUrl": "http://127.0.0.1:18083/v1/",
          "requestBody": {
            "model": "Piccolo-9B-Q8_0",
            "state": "A read-only request.",
            "questions": {
              "risk": {
                "type": "noul",
                "instructions": "Could this delete data?"
              }
            }
          }
        }
      ],
      "expected": {
        "url": "http://127.0.0.1:18083/v1/systemone",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "model": "Piccolo-9B-Q8_0",
          "state": "A read-only request.",
          "questions": {
            "risk": {
              "type": "noul",
              "instructions": "Could this delete data?"
            }
          }
        }
      }
    },
