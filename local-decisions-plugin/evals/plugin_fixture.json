    {
      "name": "selected upstream model is preserved",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "model": "Piccolo-4B-Q4_K_M",
          "upstreamModel": "Piccolo-9B-Q8_0",
          "baseUrl": "http://127.0.0.1:18083",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "risk": {
                "type": "noul",
                "instructions": "Could this delete data?"
              }
            }
          }
        }
      ],
      "expected": {
        "url": "http://127.0.0.1:18083/v1/systemone",
        "method": "POST",
        "headers": {
          "Content-Type": "application/json",
          "Accept": "application/json"
        },
        "body": {
          "model": "Piccolo-9B-Q8_0",
          "state": "A read-only request.",
          "questions": {
            "risk": {
              "type": "noul",
              "instructions": "Could this delete data?"
            }
          }
        }
      }
    },
    {
      "name": "normalized choice answer returns an immediate success",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "publicTaskId": "task_decision_1",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "action": {
                "type": "choice",
                "instructions": "Select the next action.",
                "criteria": {
                  "read": "Read without modifying.",
                  "write": "Modify the file."
                }
              }
            }
          }
        },
        {
          "statusCode": 200,
          "body": {
            "model": "piccolo-test",
            "answers": {
              "action": {
                "type": "choice",
                "choice": "read",
                "probabilities": {
                  "read": 0.9997,
                  "write": 0.0003
                },
                "confidence": 0.9995
              }
            },
            "usage": {
              "input_tokens": 412,
              "output_tokens": 0
            }
          }
        }
      ],
      "expected": {
        "taskId": "task_decision_1",
        "taskData": {
          "model": "piccolo-test",
          "answers": {
            "action": {
              "type": "choice",
              "choice": "read",
              "probabilities": {
                "read": 0.9997,
                "write": 0.0003
              },
              "confidence": 0.9995
            }
          },
          "usage": {
            "input_tokens": 412,
            "output_tokens": 0
          }
        },
        "immediate": {
          "status": "SUCCESS",
          "progress": "100%"
        }
      }
    },
    {
      "name": "unnormalized probabilities are rejected",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "publicTaskId": "task_decision_1",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "action": {
                "type": "choice",
                "instructions": "Select the next action.",
                "criteria": {
                  "read": "Read without modifying.",
                  "write": "Modify the file."
                }
              }
            }
          }
        },
        {
          "statusCode": 200,
          "body": {
            "model": "piccolo-test",
            "answers": {
              "action": {
                "type": "choice",
                "choice": "read",
                "probabilities": {
                  "read": 0.5,
                  "write": 0.4
                }
              }
            },
            "usage": {
              "input_tokens": 412,
              "output_tokens": 0
            }
          }
        }
      ],
      "expectedError": "not normalized"
    },
    {
      "name": "generated answer tokens are rejected",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "publicTaskId": "task_decision_1",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "risk": {
                "type": "noul",
                "instructions": "Could this delete data?"
              }
            }
          }
        },
        {
          "statusCode": 200,
          "body": {
            "model": "piccolo-test",
            "answers": {
              "risk": {
                "type": "noul",
                "noul": 0.1
              }
            },
            "usage": {
              "input_tokens": 412,
              "output_tokens": 7
            }
          }
        }
      ],
      "expectedError": "must not generate"
    },
    {
      "name": "upstream HTTP failure is an error",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "publicTaskId": "task_decision_1",
          "requestBody": {
            "model": "Piccolo-4B-Q4_K_M",
            "state": "A read-only request.",
            "questions": {
              "risk": {
                "type": "noul",
                "instructions": "Could this delete data?"
              }
            }
          }
        },
        {
          "statusCode": 502,
          "body": {
            "error": {
              "message": "runtime unavailable"
            }
          }
        }
      ],
      "expectedError": "HTTP 502"
    },
    {
      "name": "initial reservation uses the 8192-token maximum",
