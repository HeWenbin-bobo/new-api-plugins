    {
      "key": "local-ocr",
      "name": "Local Document OCR",
      "icon": "text:OCR",
      "description": {
        "en": "Private asynchronous PDF and image parsing through a self-hosted OCR task service.",
        "zh": "通过自托管 OCR 任务服务异步解析 PDF 和图片，输出 Markdown、JSON 和 ZIP。"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/local-ocr/v1/parse",
          "type": "submit",
          "decode": "parseDocument",
          "render": "taskCreated"
        },
        {
          "method": "GET",
          "path": "/local-ocr/v1/tasks/:task_id",
          "type": "query",
          "render": "taskStatus",
          "taskIdParam": "task_id"
        }
      ],
      "usageSchema": {
        "pages": {
          "type": "number",
          "unit": "count",
          "description": {
            "en": "Parsed pages unit price",
            "zh": "解析页数单价"
          }
        }
      },
      "usageExamples": null,
      "usageProfiles": null,
      "models": [
        "mineru-pipeline-cpu",
        "paddleocr-vl-1.6-cpu",
        "hunyuanocr-1.5-cpu",
        "glm-ocr-cpu",
        "xiaomi-ocr-0-cpu",
        "minicpm-ocr-1.0-cpu",
        "ovisocr3-cpu"
      ],
      "task": true,
      "provider": false,
      "transform": false,
      "latest": "0.1.9",
      "versions": [
        {
          "version": "0.1.9",
          "path": "local-ocr-task-plugin/plugin.js",
          "sha256": "eb5468ef7127ecd7de272862d6a9cf577ebe96de7a6a66e9bbdd5bb6879981b6",
          "minApiVersion": 1,
          "kind": "task",
          "baseUrl": "http://local-ocr.local:18082"
        }
      ]
    },
    {
      "key": "local-decisions",
      "name": "Local Decisions (Piccolo + Jev-Omni)",
      "icon": "text:LD",
      "description": {
        "en": "Piccolo and Jev-Omni native decisions through compatible llama.cpp /v1/systemone runtimes",
        "zh": "通过兼容 llama.cpp 的 /v1/systemone 提供 Piccolo 与 Jev-Omni 原生决策"
      },
      "routes": [
        {
          "method": "POST",
          "path": "/v1/systemone",
          "type": "submit",
          "decode": "decodeSystemOne",
          "render": "renderSystemOne"
        }
      ],
      "usageSchema": {
        "input_tokens": {
          "type": "number",
          "unit": "token",
          "description": {
            "en": "Input token unit price",
            "zh": "输入 token 单价"
          }
        },
